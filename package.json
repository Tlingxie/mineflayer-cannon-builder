{
  "name": "mineflayer-builder",
  "version": "1.0.1",
  "private": true,
  "description": "Physical Minecraft construction with up to 30 Mineflayer bots and strict global layer barriers",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tlingxie/mineflayer-cannon-builder.git"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "standard",
    "fix": "standard --fix",
    "web": "node scripts/web-server.js",
    "music:follow": "node scripts/music-follow.js",
    "multi-build": "node examples/strictBuilder.js",
    "multi-build:legacy": "node examples/multiBuilder.js",
    "multi-build:dev": "node examples/strictBuilder.js --fixture",
    "server:start": "node scripts/server-local.js start",
    "server:status": "node scripts/server-local.js status",
    "server:attach": "node scripts/server-attach.js",
    "server:stop": "node scripts/server-local.js stop"
  },
  "author": "Karang",
  "license": "MIT",
  "dependencies": {
    "minecraft-data": "^3.0.0",
    "mineflayer-pathfinder": "git+https://github.com/PrismarineJS/mineflayer-pathfinder.git#6f5c26bf79e7861d20e0fbc735059db51e4d8f77",
    "mojangson": "^2.1.0",
    "prismarine-block": "^1.7.3",
    "prismarine-item": "^1.5.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-provider-anvil": "^2.13.0",
    "prismarine-schematic": "^1.2.0",
    "prismarine-world": "^3.3.1",
    "vec3": "^0.1.7"
  },
  "devDependencies": {
    "mineflayer": "git+https://github.com/PrismarineJS/mineflayer.git#01f20014d7b6f70767a91a46e6d5522fd765bdbc",
    "mineflayer-builder": "file:.",
    "prismarine-viewer": "^1.13.3",
    "standard": "^17.0.0"
  }
}
